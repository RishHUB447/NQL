# Copy to .env and fill in. Everything here can also be set from the app's Settings dialog.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any OpenAI-compatible provider works (defaults shown):
# NQL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# NQL_LLM_MODEL=gemini-flash-latest
#   Groq:   NQL_LLM_BASE_URL=https://api.groq.com/openai/v1   NQL_LLM_API_KEY=...  NQL_LLM_MODEL=<model id>
#   Ollama: NQL_LLM_BASE_URL=http://localhost:11434/v1         NQL_LLM_API_KEY=ollama NQL_LLM_MODEL=qwen2.5-coder

# Optional: connect automatically on startup.
# NQL_DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# NQL_ROW_LIMIT=200
# NQL_STATEMENT_TIMEOUT_MS=10000
# NQL_MAX_FIX_ATTEMPTS=2
# NQL_MAX_TABLES_IN_PROMPT=25
